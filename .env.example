# Copy to .env and fill in. Without these the bot runs in dry-run mode
# (alerts print to console instead of Telegram).

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your chat id (message @userinfobot, or hit getUpdates after messaging your bot)
TELEGRAM_CHAT_ID=

# Kalshi series for the 15-min BTC up/down markets (verified live)
KALSHI_SERIES_TICKER=KXBTC15M


# -----------------------------------------------------------------------------
# Kalshi authenticated access  (OPTIONAL -- read-only, Phase 1)
# -----------------------------------------------------------------------------
# Only needed to run check_kalshi_auth.py. Nothing in this repo places orders;
# kalshi_auth.py is GET-only by construction. Leave these blank and everything
# else (alerts, paper trading, dashboard) works exactly as before.
#
# HOW TO GET THESE -- you do this yourself, in Kalshi's UI:
#   1. Sign in to the DEMO exchange at https://demo.kalshi.co
#      (separate account AND separate credentials from production -- a demo key
#       will not authenticate against the real exchange, by design)
#   2. Account -> Settings -> API Keys -> create/generate a new key
#   3. Copy the Key ID into KALSHI_API_KEY_ID below
#   4. Save the RSA private key it shows you to kalshi_private_key.pem in this
#      folder, including the -----BEGIN/END----- lines. Kalshi shows that key
#      EXACTLY ONCE and cannot re-issue it -- if it is lost, revoke the key and
#      generate a new one. *.pem is gitignored; never commit it.
#   5. Run:  python check_kalshi_auth.py
#
# "demo" or "prod". Defaults to demo when unset, deliberately -- production
# should be an explicit choice, never the result of a missing variable.
KALSHI_ENV=demo

# The Key ID string from step 3 (NOT the private key itself).
KALSHI_API_KEY_ID=

# Path to the .pem from step 4. Relative to the repo root, or absolute.
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
