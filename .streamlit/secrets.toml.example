# -----------------------------------------------------------------------------
# Secrets template  —  COPY, DON'T COMMIT THE REAL ONE
# -----------------------------------------------------------------------------
# Local use:   copy this file to  .streamlit/secrets.toml  and fill in values.
#              (.streamlit/secrets.toml is gitignored and must NEVER be committed.)
#
# Streamlit Community Cloud:  do NOT upload a file. After the app deploys, open
#              Manage app -> Settings -> Secrets and paste the lines below (only
#              the ones you want). Streamlit Cloud exposes each secret BOTH via
#              st.secrets AND as an environment variable, which is how this app
#              reads them (os.environ.get), so no code change is needed.
#
# This is OPTIONAL — the dashboard runs fine with nothing set at all.
# -----------------------------------------------------------------------------

# Password gate for the dashboard. STRONGLY RECOMMENDED for a public Cloud URL —
# without it, anyone who has the link can open the app. Omit it (or leave unset)
# and the app opens with no password, which is the right default only when
# access is already restricted (e.g. a private Tailscale network).
# KALSHI_DASHBOARD_PASSWORD = "choose-a-password"

# Kalshi and Coinbase market-data endpoints used by this dashboard are public
# and need no key. TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID are only used by the
# separate alert bot (bot.py), which the Cloud dashboard never runs -- nothing
# to set here for those. Nothing else to configure for read-only viewing.
